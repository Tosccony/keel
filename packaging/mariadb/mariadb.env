# The MariaDB that Keel ships. Scripts source this file.
#
# 11.8 is a long-term-support series, supported until February 2030.
# To move to a newer release, change the version and every checksum
# together. The checksums come from MariaDB's own list:
#   https://downloads.mariadb.org/rest-api/mariadb/11.8/latest/
MARIADB_VERSION=11.8.9

# Source code, built for macOS by scripts/build-mariadb.sh (MariaDB
# doesn't publish macOS builds).
MARIADB_SOURCE_SHA256=2e015b7e91004142eda8b3a20d3ceb875cf2ae55e72603e7222cd497d4e56fc6

# Official builds, downloaded and trimmed by scripts/fetch-mariadb.sh.
MARIADB_WINDOWS_SHA256=830c46727d9278eae212ae3eca44eeb9e71b2a68704e95f344a64fba7b1963f5
MARIADB_LINUX_SHA256=32f8871a2aa38b36aa418b7f4abc6fc0c6ef1ba5a45798cacb2afa52c8a6113b
