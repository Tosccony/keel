# The phpMyAdmin that Keel ships. Scripts source this file.
# 5.2.3 runs cleanly on PHP 8.4. To move to a newer release, change both
# lines together; the checksum is published beside each download:
#   https://files.phpmyadmin.net/phpMyAdmin/<version>/phpMyAdmin-<version>-all-languages.zip.sha256
PHPMYADMIN_VERSION=5.2.3
PHPMYADMIN_SHA256=2d2e13c735366d318425c78e4ee2cc8fc648d77faba3ddea2cd516e43885733f

# phpMyAdmin as the Web workflow published it (phpmyadmin-<version>.tar.gz
# in release web-<apache>-php<php>). scripts/fetch-runtimes.sh checks the
# download against this. After a publish run, copy it from that release's
# SHA256SUMS.txt.
PHPMYADMIN_RUNTIME_SHA256=00ec15f9a0eb76259d6f9abdef5022d93c50e42a12c64af789cc254eafa24bdc
